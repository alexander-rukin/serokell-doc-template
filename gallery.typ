// Serokell slide system - layout gallery.
// One slide per layout, real sample content, so the whole visual vocabulary is
// visible at a glance. Faint mono tag in the top-right names each layout.

#import "slides.typ": *

#cover(
  [Serokell slide system],
  subtitle: [Витрина раскладок - один бренд, много форматов слайда],
  meta: [Демо-колода · сгенерирована на том же Typst-пайплайне · 24 июля 2026],
  tag: "cover",
)

// =====================  ОБЛОЖКИ И РАЗДЕЛЫ  ==================================
#section([Обложки и разделы], tag: "section")

#statement(
  [Одна мысль, набранная #ac[крупно] и~с~воздухом.],
  sub: [Подзаголовок поясняет и уводит взгляд вниз, к горам со знаком Serokell.],
  tag: "statement",
)

// =====================  ТЕКСТ И СПИСКИ  ====================================
#section([Текст и списки], tag: "section")

#highlight(
  [Одна мысль],
  [Слайд, чтобы подсветить #ac[что-то одно] важное. Держи коротко - при желании уведи ссылкой на документ или файл.],
  tag: "highlight",
)

#bullets(
  [Список тезисов],
  (
    ([Заголовок держит секцию], [Он задаёт, о чём этот пункт, одной короткой фразой.]),
    ([Текст поясняет], [Строка под заголовком раскрывает мысль, но не переполняет.]),
    ([Каждый пункт - мини-блок], [Как на карточках: заголовок плюс поддержка, а не голая строка.]),
    ([Ровный ритм], [Одинаковый отступ между блоками держит список спокойным.]),
  ),
  lead: [Когда контент - перечисление #ac[равнозначных]~пунктов.],
  tag: "bullets",
)

#columns(
  [Список в ряд],
  (
    ([Первое], [Короткое описание каждого пункта с достаточным контекстом.]),
    ([Второе], [Держи ёмко, чтобы легко читалось и запоминалось.]),
    ([Третье], [Нужно больше - добавь ещё колонку или ещё слайд.]),
  ),
  lead: [То же перечисление, но горизонтально - без карточек, на открытом поле.],
  tag: "columns-3",
)

#columns(
  [Четыре в ряд],
  (
    ([Первое], [Короткое описание с контекстом.]),
    ([Второе], [Ёмко и по делу.]),
    ([Третье], [Легко сканировать.]),
    ([Четвёртое], [Дальше - копия слайда.]),
  ),
  tag: "columns-4",
)

#two-col(
  [Две колонки],
  ([Левая колонка], [Два независимых потока текста рядом - удобно для «проблема / решение» или сравнения двух аспектов темы без жёсткой рамки-панели.]),
  ([Правая колонка], [Колонки равной ширины, выключены влево, с общим верхом. Раскладка не навязывает противопоставление, просто делит внимание на~два.]),
  tag: "two-col",
)

#feature-grid(
  [Четыре блока],
  (
    ([Первое], [Короткое описание с контекстом.]),
    ([Второе], [Держи ёмко и понятно.]),
    ([Третье], [Легко сканировать взглядом.]),
    ([Четвёртое], [Сетка 2×2 рядом с заголовком.]),
  ),
  tag: "feature-grid",
)

// =====================  КАРТОЧКИ И СРАВНЕНИЯ  ==============================
#section([Карточки и сравнения], tag: "section")

#cards(
  [Карточки в ряд],
  (
    ([template.typ], [Токены, обложка, футер. Бренд живёт здесь один.]),
    ([render / main], [Общая обёртка: путь, фронтматтер, тело.]),
    ([content/md], [Территория автора. Только~контент.]),
  ),
  lead: [Три-четыре равнозначных блока - роли, компоненты, принципы.],
  tag: "cards",
)

#compare(
  [До и после],
  [Без шаблона],
  [Каждый документ форкает стиль: цвета плывут, заголовки пухнут, бренд растворяется - и никто не~замечает.],
  [С шаблоном],
  [Автор пишет только контент. Бренд накатывается сам, одинаково, каждый раз. Правка бренда - один файл, ревью один раз.],
  tag: "compare",
)

#steps(
  [Процесс по шагам],
  (
    [Бриф: тема, аудитория,~тон],
    [Я компоную слайды],
    [Ты правишь словами],
    [Пересборка в PDF],
  ),
  tag: "steps",
)

#agenda(
  [Оглавление],
  (
    [Проблема: каждый форкает стиль],
    [Решение: один шаблон],
    [Как это устроено],
    [Что это даёт],
    [Дальше],
  ),
  tag: "agenda",
)

// =====================  ЦИФРЫ И ДАННЫЕ  ====================================
#section([Цифры и данные], tag: "section")

#statement(
  [XX#h(0.02em)%],
  sub: [Подсвети ключевую метрику - цель, ориентир или инсайт, который держит нить всей деки.],
  tag: "big-metric",
)

#kpis(
  [Итоги в цифрах],
  (
    ([3x], [быстрее собирается колода]),
    ([1#h(0.3em)файл], [правит весь бренд]),
    ([0], [ручной вёрстки слайдов]),
  ),
  tag: "kpis",
)

#metric-cols(
  [Метрики с описанием],
  (
    ([61%], [Короткое описание метрики с достаточным контекстом.]),
    ([56%], [Нужно больше - добавь ещё колонку или слайд.]),
    ([48%], [Держи ёмко, чтобы легко читалось.]),
  ),
  tag: "metric-cols",
)

#metric-list(
  [Ключевые метрики],
  (
    ([61%], [Метрика 1], [Описание или подсветка изменения]),
    ([56%], [Метрика 2], [Описание или подсветка изменения]),
    ([48%], [Метрика 3], [Описание или подсветка изменения]),
  ),
  tag: "metric-list",
)

#metric-grid(
  [Метрики],
  [Описание данных рядом. Коротко - что это за числа и почему важны.],
  (
    ([61%], [Метрика 1]),
    ([56%], [Метрика 2]),
    ([55%], [Метрика 3]),
    ([48%], [Метрика 4]),
  ),
  tag: "metric-grid",
)

#table-slide(
  [Сравнение подходов],
  ([Критерий], [Без шаблона], [С шаблоном]),
  (
    ([Стиль], [каждый форкает свой], [один на всех]),
    ([Правка бренда], [руками в каждом], [один файл]),
    ([Ревью], [каждый раз], [один раз]),
    ([Время на вёрстку], [часы], [минуты]),
  ),
  tag: "table",
)

// =====================  ДИАГРАММЫ  =========================================
#section([Диаграммы], tag: "section")

#roadmap(
  [Как мы к этому пришли],
  (
    ([H2 2024], [Прототип и первые слайды на одной команде.]),
    ([H1 2025], [Пилот: собрали пару реальных дек, собрали фидбэк.]),
    ([H2 2025], [Раскатали шаблон на остальные команды.]),
    ([H1 2026], [Итоги, метрики и план на следующий цикл.]),
  ),
  tag: "roadmap",
)

#timeline(
  [Простой таймлайн],
  (
    ([Q1], [Прототип и первые слайды]),
    ([Q2], [Пилот на одной команде]),
    ([Q3], [Раскатка на всех]),
    ([Q4], [Итоги и план]),
  ),
  tag: "timeline",
)

#matrix2x2(
  [Матрица 2x2],
  [Показать, где живут несколько идей по~двум независимым осям.],
  ([Дёшево], [Дорого]),
  ([Высокий эффект], [Низкий эффект]),
  ([Сделать первым], [Обсудить], [Быстрые победы], [Не сейчас]),
  tag: "matrix-2x2",
)

#venn(
  [Диаграмма Венна],
  [Показать, как несколько понятий пересекаются и чем каждое уникально.],
  ([Только A], [Оба], [Только B]),
  tag: "venn",
)

#nested(
  [Вложенность],
  [Показать, как несколько понятий вложены одно в~другое.],
  ([Внешнее], [Среднее], [Ядро]),
  tag: "nested",
)

#funnel(
  [Воронка],
  [Показать, как этапы сужаются последовательно, сверху вниз.],
  ([Охват], [Интерес], [Заявки], [Сделки], [Клиенты]),
  tag: "funnel",
)

// =====================  ЛЮДИ И ОТЗЫВЫ  =====================================
#section([Люди и отзывы], tag: "section")

#quote-slide(
  [Самый убедительный пример вывода - это #ac[сам вывод]],
  who: [слайд про эту деку],
  tag: "quote",
)

#testimonial(
  [Это яркая цитата пользователя или клиента, которая по-настоящему цепляет],
  name: [Имя Фамилия],
  loc: [Компания],
  tag: "testimonial",
)

#testimonials(
  (
    ([Лучшие цитаты работают на общую нить твоей деки], [Имя Фамилия · Компания]),
    ([Держи их короткими - так они легче считываются], [Имя Фамилия · Компания]),
    ([Три отзыва в ряд - удобный социальный пруф], [Имя Фамилия · Компания]),
  ),
  tag: "testimonials-3",
)

#testimonials(
  (
    ([Лучшие цитаты работают на общую нить твоей деки], [Имя Фамилия · Компания]),
    ([Держи их короткими - так они легче считываются], [Имя Фамилия · Компания]),
  ),
  avatars: false,
  tag: "testimonials-2",
)

#team(
  [Команда],
  (
    ([Имя Фамилия], [Роль]), ([Имя Фамилия], [Роль]), ([Имя Фамилия], [Роль]),
    ([Имя Фамилия], [Роль]), ([Имя Фамилия], [Роль]), ([Имя Фамилия], [Роль]),
    ([Имя Фамилия], [Роль]), ([Имя Фамилия], [Роль]), ([Имя Фамилия], [Роль]),
    ([Имя Фамилия], [Роль]), ([Имя Фамилия], [Роль]),
  ),
  tag: "team",
)

// =====================  ВИЗУАЛЫ И УСТРОЙСТВА  ==============================
#section([Визуалы и устройства], tag: "section")

#split(
  [Текст и визуал],
  [Текст слева, картинка справа. Раскладка для скриншота, диаграммы, фото продукта - всего, что нужно показать рядом с объяснением, а~не~под~ним.

  Картинка задаётся одним полем - это любой #box[PNG/JPG/SVG], кадрируется по~рамке.],
  img: "assets/sample-photo.jpg",
  tag: "split-image",
)

#split(
  [Визуал во всю высоту],
  [Тот же split, но картинка идёт от края до края справа - на всю высоту слайда. Для крупного скрина или фото, которому нужно больше воздуха.],
  img: "assets/sample-photo.jpg",
  bleed: true,
  tag: "split-bleed",
)

#split(
  [Текст и панель-заглушка],
  [Когда финального ассета ещё нет - на его месте брендовая панель-заглушка с подписью, чтобы место под визуал было видно на~черновике.],
  label: [сюда ляжет схема / скрин / фото],
  tag: "split-panel",
)

#image-row(
  [Визуалы с подписями],
  (
    (none, [Первое], [Короткое описание каждого визуала с контекстом.]),
    (none, [Второе], [Держи ёмко, чтобы легко читалось.]),
    (none, [Третье], [Нужно больше - добавь ещё ряд.]),
  ),
  tag: "image-row",
)

#image-full(
  caption: [Подпись к визуалу],
  tag: "image-full",
)

#mobile-showcase(
  [Мобильные экраны],
  [Поддержи визуал парой строк контекста и уведи ссылкой на дизайны. Один экран или несколько рядом.],
  n: 3,
  tag: "mobile-showcase",
)

#desktop-showcase(
  [Десктопные экраны],
  [Тот же приём для веба: скрин в рамке ноутбука рядом с коротким пояснением.],
  tag: "desktop-showcase",
)

#annotated(
  title: [Аннотированный экран],
  notes: (
    ("left", 55, [Верхний элемент]),
    ("right", 88, [Правый элемент]),
    ("left", 108, [Нижний элемент]),
  ),
  tag: "annotated",
)

// =====================  КОД И АКЦЕНТЫ  =====================================
#section([Код и акценты], tag: "section")

#code-slide(
  [Код на слайде],
  ```sh
  typst compile \
    --font-path assets/fonts \
    --ignore-system-fonts \
    deck.typ deck.pdf
  ```,
  caption: [Моноширинный блок - для команд, конфигов, коротких сниппетов.],
  tag: "code",
)

#callout(
  [Один источник бренда - и вся колода едет за ним.],
  sub: [Правишь токены в одном файле, пересборка обновляет каждый слайд разом.],
  tag: "callout",
)

#closing(
  [Эта колода собрана тем же инструментом, что описывает.],
  sub: [Те же токены, шрифты и горы. Одна оболочка - тридцать с лишним форматов слайда.],
  tag: "closing",
)
