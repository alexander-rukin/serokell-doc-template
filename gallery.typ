// Serokell slide system - layout gallery.
// One slide per layout, real sample content, so the whole visual vocabulary is
// visible at a glance. Faint mono tag in the top-right names each layout.

#import "slides.typ": *

#cover(
  [Serokell slide system],
  subtitle: [Витрина раскладок - один бренд, много форматов слайда],
  meta: [Демо-колода · сгенерирована на том же Typst-пайплайне · 23 июля 2026],
  tag: "cover",
)

#section("01", [Раздел-разделитель], tag: "section")

#statement(
  [Одна мысль, набранная крупно и с воздухом.],
  sub: [Подзаголовок поясняет и уводит взгляд вниз, к горам со знаком Serokell.],
  tag: "statement",
)

#bullets(
  [Список тезисов],
  (
    [Заголовок держит секцию, буллеты - её содержание.],
    [Красные маркеры - тот же акцент, что и во всём бренде.],
    [Строки дышат: межстрочный и межпунктовый интервал заданы токенами.],
    [Хорошо для повесток, выводов, чек-листов - линейного перечисления.],
  ),
  lead: [Когда контент - это перечисление равнозначных пунктов.],
  tag: "bullets",
)

#two-col(
  [Две колонки],
  [*Левая колонка.* Два независимых потока текста рядом - удобно для «проблема / решение», «контекст / вывод» или сравнения двух аспектов одной темы без жёсткой рамки-панели.],
  [*Правая колонка.* Колонки равной ширины, выключены влево, с общим верхом. Раскладка не навязывает противопоставление - просто делит внимание на два.],
  tag: "two-col",
)

#split(
  [Текст и визуал],
  [Текст слева, картинка справа. Раскладка для скриншота, диаграммы, фото продукта - всего, что нужно показать рядом с объяснением, а не под ним.

  Картинка задаётся одним полем - это любой PNG/JPG/SVG, кадрируется по рамке.],
  img: "assets/sample-photo.jpg",
  tag: "split-image",
)

#split(
  [Текст и панель-заглушка],
  [Тот же split, но картинки пока нет. Вместо неё - брендовая панель-заглушка с подписью, чтобы место под визуал было видно на черновике, до того как появится финальный ассет.],
  label: [сюда ляжет схема / скрин / фото],
  tag: "split-panel",
)

#stat(
  [1 файл],
  [меняешь бренд - правишь одно место],
  sub: [Крупное число или короткая величина как якорь слайда: метрика, цена, дельта, результат.],
  tag: "stat",
)

#quote-slide(
  [Самый убедительный пример вывода - это сам вывод.],
  who: [слайд про эту деку],
  tag: "quote",
)

#compare(
  [До и после],
  [БЕЗ ШАБЛОНА],
  [Каждый документ форкает стиль: цвета плывут, заголовки пухнут, бренд растворяется - и никто не замечает.],
  [С ШАБЛОНОМ],
  [Автор пишет только контент. Бренд накатывается сам, одинаково, каждый раз. Правка бренда - один файл, ревью один раз.],
  tag: "compare",
)

#code-slide(
  [Код на слайде],
  ```sh
  typst compile \
    --font-path assets/fonts \
    --ignore-system-fonts \
    deck.typ deck.pdf
  ```,
  caption: [Моноширинный блок со спайном-акцентом - для команд, конфигов, коротких сниппетов.],
  tag: "code",
)

#steps(
  [Процесс по шагам],
  (
    [Бриф: тема, аудитория, тон],
    [Я компоную слайды],
    [Ты правишь словами],
    [Пересборка в PDF],
  ),
  tag: "steps",
)

#cards(
  [Карточки в ряд],
  (
    ([template.typ], [Токены, обложка, футер. Бренд живёт здесь один.]),
    ([render / main], [Общая обёртка: путь, фронтматтер, тело.]),
    ([content/md], [Территория автора. Только контент.]),
  ),
  lead: [Три-четыре равнозначных блока - роли, компоненты, принципы.],
  tag: "cards",
)

#closing(
  [Эта колода собрана тем же инструментом, что описывает.],
  sub: [Те же токены, шрифты и горы. Одна оболочка - тринадцать форматов слайда.],
  tag: "closing",
)
